# Copy to .env on the server only. Never commit real values.
NODE_ENV=development
JOBS_ORIGIN=http://127.0.0.1:8080
HR_ORIGIN=http://127.0.0.1:8080
JOBS_HOST=jobs.muke.media
HR_HOST=hr.muke.media
TRUST_PROXY=0
# Keep current live forms until return URLs and referral attribution are verified.
APPLICATIONS_ENABLED=0
# Server sync is opt-in; existing GitHub sync continues during validation.
SYNC_ENABLED=0
SCOUT_LOGIN_ENABLED=0
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_TOKEN=
# Login application and its own open_id namespace; do not reuse another app's IDs.
LARK_LOGIN_APP_ID=
LARK_LOGIN_APP_SECRET=
LARK_TENANT_KEY=
HR_ADMIN_OPEN_IDS=

# Temporary identity-only setup; does not grant HR access. Turn off after verification.
HR_IDENTITY_SETUP_ENABLED=0
